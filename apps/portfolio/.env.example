# Copy to .env.local and fill in. Real values live in Vercel → Settings → Environment Variables.
# Every variable is listed in src/lib/env.ts; `npm run env:check` reports what is missing.
# A production deploy stops if a "required in production" value is missing.

# --- Database (required in production) ---
# Postgres connection string from Neon (use the pooled one). Without it the site
# runs on the seed access levels and /admin is unavailable.
DATABASE_URL=

# --- Admin (/admin) ---
# Signs guest passwords and admin sessions (required in production).
# 32+ random characters; never change once set or every guest password stops working.
ADMIN_SESSION_SECRET=
# First admin sign-in, only while the admin_account table is empty. After that the
# password is changed in the console (Settings).
ADMIN_PASSWORD=

# --- Email through Resend (resend.com) ---
# Sends access requests and invitations (required in production).
RESEND_API_KEY=
# Optional sender on a verified Resend domain. Defaults to Showcase <onboarding@resend.dev>,
# which can only email the Resend account owner.
ACCESS_REQUEST_FROM=

# --- Showcase access seed ---
# Initial seed for the access tables only (SEED_LEVELS in src/lib/access/levels.ts).
# One entry per person, comma-separated: name:password:project+project
# Use * instead of a project list to open every protected project.
SHOWCASE_ACCESS=

# --- Site ---
# Optional canonical URL, e.g. https://example.com. Defaults to the Vercel production domain.
NEXT_PUBLIC_SITE_URL=
