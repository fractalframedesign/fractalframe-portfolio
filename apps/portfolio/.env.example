# Who can open the protected showcase projects (SEED_LEVELS in src/lib/access/levels.ts).
# One entry per person, comma-separated: name:password:project+project
# Use * instead of a project list to open every protected project.
SHOWCASE_ACCESS=

# "Request access" form on the password page emails CONTACT_EMAIL through Resend (resend.com).
RESEND_API_KEY=
# Optional sender, once you verify a domain in Resend. Defaults to Showcase <onboarding@resend.dev>
ACCESS_REQUEST_FROM=

# Showcase admin (/admin). Postgres connection string from Neon (use the pooled one).
DATABASE_URL=
# Password for signing in to /admin.
ADMIN_PASSWORD=
# Signs guest passwords and admin sessions. 32+ random characters; never change once set or every guest password stops working.
ADMIN_SESSION_SECRET=
